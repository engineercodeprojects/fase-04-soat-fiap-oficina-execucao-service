PORT=3002
# Segredo HS256 compartilhado com a Lambda de autenticacao (Secrets Manager em producao)
JWT_SECRET=change-me-to-a-strong-random-secret
# JWT_ISSUER=oficina-auth-lambda
LOG_LEVEL=debug

# ─── DynamoDB (banco proprio deste servico — RFC-0004) ───────────────────────
AWS_REGION=us-east-1
# DynamoDB Local (docker compose up -d dynamodb). Vazio = AWS real (credenciais do pod/IRSA).
DYNAMODB_ENDPOINT=http://localhost:8000
# Prefixo dos nomes: <prefixo>execucoes, <prefixo>servicos, <prefixo>produtos, <prefixo>movimentacoes_estoque
DYNAMODB_TABLE_PREFIX=oficina-dev-
# Overrides opcionais do nome completo de cada tabela (vencem o prefixo):
# DYNAMODB_TABLE_EXECUCOES=
# DYNAMODB_TABLE_SERVICOS=
# DYNAMODB_TABLE_PRODUTOS=
# DYNAMODB_TABLE_MOVIMENTACOES_ESTOQUE=

# ─── OS Service (HTTP) ──────────────────────────────────────────────────────
# Vazio em dev = propagacao para o OS desligada (apenas log). Obrigatorio em producao.
OS_SERVICE_URL=http://localhost:3000
# Contrato configuravel (defaults abaixo); ver README "Integracao com o OS Service".
# OS_SERVICE_HTTP_METHOD=PATCH
# OS_SERVICE_MECANICO_PATH=/os/{osId}/mecanico
# OS_SERVICE_STATUS_PATH=/os/{osId}/status
# OS_SERVICE_STATUS_MAP={"EXECUTADA":"FINALIZADA"}
# OS_SERVICE_TIMEOUT_MS=5000
# OS_SERVICE_RETRIES=2

# APM (opcional)
DD_TRACE_ENABLED=false
DD_SERVICE=oficina-execucao-service
