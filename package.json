{
  "name": "oficina-execucao-service",
  "version": "0.1.0",
  "private": true,
  "description": "Execucao de OS: atribuicao de mecanico, diagnostico, catalogo de servicos/produtos e estoque com DynamoDB (Execucao Service) — microsservico da Oficina Mecanica (Tech Challenge FIAP, Fase 4)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "lint": "eslint src",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.unit.config.js",
    "test:unit:cov": "jest --config jest.unit.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:cov": "jest --config jest.integration.config.js --coverage",
    "test:all:cov": "npm run test:unit:cov && npm run test:integration:cov",
    "docker:up": "docker compose up -d dynamodb && npm run dynamodb:create-tables",
    "docker:down": "docker compose down -v",
    "dynamodb:create-tables": "ts-node src/dynamodb/create-tables.cli.ts",
    "dynamodb:create-tables:prod": "node dist/dynamodb/create-tables.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@guilhermeqmaia/oficina-kit": "^0.3.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.2.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "optionalDependencies": {
    "dd-trace": "^5.127.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.0",
    "jest": "^30.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "testcontainers": "^11.9.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "multer": "^2.5.0",
    "body-parser": "^2.4.0",
    "js-yaml": "^5.5.0"
  }
}
